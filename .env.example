PICUS_API_BASE_URL=https://api.picussecurity.com
PICUS_REFRESH_TOKEN=your-picus-refresh-token
PICUS_VERIFY_SSL=true

HX_BASE_URL=https://hx.example.com:3000
HX_USERNAME=api-analyst
HX_PASSWORD=your-password
HX_VERIFY_SSL=true
HX_INDICATOR_CATEGORY=Custom
HX_INDICATOR_NAME=picus_deny_list
HX_HOST_SET_ID=1000
# true = read everything, write nothing to HX
DRY_RUN=true

# Only for host-lookup --incident
SOAR_HOST=soar.example.com
SOAR_PORT=443
SOAR_ORG=Example Org
SOAR_API_KEY_ID=your-api-key-id
SOAR_API_KEY_SECRET=your-api-key-secret
SOAR_CAFILE=
